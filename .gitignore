# Case-specific production artifacts: never commit secrets, customer data, or raw logs.
org-snapshots/*
!org-snapshots/README.md
logs/*
!logs/README.md
*.log
*.debug
*.token
*.key
*.pem
*.auth

# Claude Code local state: per-machine, never shared.
.claude/settings.local.json
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock
